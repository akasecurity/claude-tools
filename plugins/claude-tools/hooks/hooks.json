{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bun-hook-launch.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/command-guard.ts\""
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|mcp__searxng__",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bun-hook-launch.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/leak-guard.ts\""
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bun-hook-launch.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/mcp-guard.ts\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/preflight.sh\""
          }
        ]
      }
    ]
  }
}
